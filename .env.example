# raglib environment variables. Copy to .env and fill in ONLY the providers you use.
# Never commit .env. raglib reads these from the process environment (load .env with
# python-dotenv, or use your deployment's secret manager).

# ---- LLM providers (set at least one, or use offline=True)
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=http://localhost:8000/v1
# ANTHROPIC_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here
# GROQ_API_KEY=your-key-here
# OLLAMA_BASE_URL=http://localhost:8000/v1
# OPENROUTER_API_KEY=your-key-here
# DEEPSEEK_API_KEY=your-key-here
# MISTRAL_API_KEY=your-key-here
# TOGETHER_API_KEY=your-key-here
# FIREWORKS_API_KEY=your-key-here
# XAI_API_KEY=your-key-here
# PERPLEXITY_API_KEY=your-key-here
# CEREBRAS_API_KEY=your-key-here
# LMSTUDIO_API_KEY=your-key-here
# LMSTUDIO_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=your-key-here
# VLLM_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=your-key-here
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# AZURE_OPENAI_API_KEY=your-key-here
# AZURE_OPENAI_ENDPOINT=http://localhost:8000/v1
# OPENAI_API_VERSION=2024-10-21
# OPENROUTER_APP_NAME=my-app
# OPENROUTER_SITE_URL=https://example.com

# ---- Reranking / web search (optional)
# COHERE_API_KEY=your-key-here
# TAVILY_API_KEY=your-key-here
# SERPAPI_API_KEY=your-key-here
# BRAVE_API_KEY=your-key-here
# BING_SEARCH_API_KEY=your-key-here
# GOOGLE_CSE_ID=your-engine-id
# EXA_API_KEY=your-key-here
# SEARXNG_BASE_URL=http://localhost:8080

# ---- Tests / demos: use the offline mock models
# RAGLIB_OFFLINE=1
